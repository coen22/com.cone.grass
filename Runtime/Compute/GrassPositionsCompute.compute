#pragma kernel ResetCounts
#pragma kernel CSMain
#pragma kernel FinalizeArgs

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"

// Keep one explicit constant-buffer layout across all kernels. Grid indices and
// indirect-argument byte offsets must be uploaded with integer setters.
CBUFFER_START(GrassGenerationParameters)
    float _Spacing;
    float _DrawDistance;
    float _TextureUpdateThreshold;
    float _FullDensityDistance;

    float _DensityFalloffExponent;
    float _DensityTransition;
    float _BladeBoundsRadius;
    float _LodTransitionWidth;

    int2 _GridStartIndex;
    int2 _GridSize;
    float3 _CameraPosition;
    int _AuthoredAreas;
    float2 _CenterPos;
    float2 _LodDistances;

    int4 _LodOffsets;
    int4 _LodCapacities;
    int _ArgsStride;
    int _ArgsInstanceCountOffset;
    int _UseTerrain;
    int _TerrainHasHoles;
    float3 _TerrainOrigin;
    float _TerrainPadding0;
    float3 _TerrainSize;
    float _TerrainPadding1;

    // Normalized, inward-facing world-space planes from the rendering camera.
    float4 _FrustumPlanes[6];
CBUFFER_END

SamplerState linearClampSampler;
SamplerState pointClampSampler;

// Capture textures share the world-XZ mapping defined by _CenterPos and extent.
// Height is stored directly in world units; validity and density are independent.
Texture2D<float2> _GrassHeightMapRT;
Texture2D<float> _GrassDensityRT;
Texture2D<float> _GrassMaskMapRT;

// A Terrain dispatch owns a half-open XZ rectangle. The heightmap must retain
// all four channels: Unity packs height into RG on Vulkan/GLES/WebGPU.
Texture2D<float4> _TerrainHeightmap;
Texture2D<float> _TerrainHoles;

// One persistent buffer, partitioned into three non-overlapping LOD ranges.
// xyz = world-space root, w = fractional coverage for the blade shader.
RWStructuredBuffer<float4> _GrassPositions;
// Attempted near/middle/far counts, then the number rejected by capacity limits.
RWStructuredBuffer<uint> _GrassCounts;
RWByteAddressBuffer _GrassIndirectArgs;

uint GrassHash(uint value)
{
    value ^= value >> 16;
    value *= 0x85ebca6bu;
    value ^= value >> 13;
    value *= 0xc2b2ae35u;
    value ^= value >> 16;
    return value;
}

uint GrassCellSeed(int2 cell)
{
    // Preserve signed-coordinate bits: abs() would mirror seeds across axes.
    return GrassHash(GrassHash(asuint(cell.x) ^ 0x9e3779b9u) ^ asuint(cell.y));
}

float GrassRandom(uint seed, uint stream)
{
    // The upper 24 bits are exactly representable, and the result never hits 1.
    return (GrassHash(seed ^ stream) >> 8) * (1.0 / 16777216.0);
}

bool GrassInFrustum(float3 positionWS)
{
    float radius = max(_BladeBoundsRadius, 0.0);
    [unroll]
    for (uint plane = 0; plane < 6; ++plane)
    {
        if (dot(_FrustumPlanes[plane].xyz, positionWS) + _FrustumPlanes[plane].w < -radius)
            return false;
    }
    return true;
}

bool GrassTerrainHeight(float2 positionXZ, out float heightWS)
{
    heightWS = 0.0;
    if (any(_TerrainSize.xz <= 0.0))
        return false;

    float2 terrainUV = (positionXZ - _TerrainOrigin.xz) / _TerrainSize.xz;
    // Half-open bounds give a root on a shared edge exactly one Terrain owner.
    if (any(terrainUV < 0.0) || any(terrainUV >= 1.0))
        return false;

    if (_TerrainHasHoles != 0)
    {
        // Match URP TerrainLitInput. Compressed holes may contain ~1/2047
        // instead of zero; point sampling prevents grass crossing hole edges.
        float hole = _TerrainHoles.SampleLevel(pointClampSampler, terrainUV, 0);
        if (hole < 0.0005)
            return false;
    }

    uint width, height;
    _TerrainHeightmap.GetDimensions(width, height);
    float2 resolution = float2(width, height);
    // Terrain vertices span (resolution - 1) intervals. Sampling raw terrainUV
    // would move the first/last samples half a texel into the supporting surface.
    float2 heightUV = (terrainUV * (resolution - 1.0) + 0.5) / resolution;
    float nativeHeight = UnpackHeightmap(_TerrainHeightmap.SampleLevel(linearClampSampler, heightUV, 0));

    // PaintContext.kNormalizedHeightScale = 32766 / 65535. UnpackHeightmap
    // handles API-specific channel packing, but does not undo this height range.
    heightWS = _TerrainOrigin.y + nativeHeight * _TerrainSize.y * (65535.0 / 32766.0);
    return true;
}

float GrassDensityCoverage(float probability, float randomValue)
{
    if (probability <= 0.0)
        return 0.0;
    if (probability >= 1.0)
        return 1.0;

    float band = min(max(_DensityTransition, 0.0), min(probability, 1.0 - probability));
    if (band <= 0.0)
        return randomValue < probability ? 1.0 : 0.0;

    // Fade only the population close to its stable random threshold. For a
    // uniformly distributed threshold, integrated coverage remains probability.
    return saturate((probability + 0.5 * band - randomValue) / max(band, 1e-7));
}

uint GrassSelectLod(float distanceToCamera, float randomValue)
{
    float nearDistance = max(_LodDistances.x, 0.0);
    float farDistance = max(_LodDistances.y, nearDistance);
    // Avoid overlapping transitions when thresholds are edited close together.
    float width = min(max(_LodTransitionWidth, 0.0), farDistance - nearDistance);
    if (width <= 1e-5)
        return distanceToCamera >= farDistance ? 2u : (distanceToCamera >= nearDistance ? 1u : 0u);

    float halfWidth = width * 0.5;
    float toMiddle = saturate((distanceToCamera - nearDistance + halfWidth) / width);
    float toFar = saturate((distanceToCamera - farDistance + halfWidth) / width);
    // Exactly one mesh per root; an independent stable hash prevents density
    // thinning from biasing the LOD distribution or reshuffling with the camera.
    if (randomValue < toFar)
        return 2u;
    return randomValue < toMiddle ? 1u : 0u;
}

[numthreads(4, 1, 1)]
void ResetCounts(uint3 id : SV_DispatchThreadID)
{
    if (id.x < 4)
        _GrassCounts[id.x] = 0;
}

[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    // Dispatch dimensions are rounded up to whole groups, never whole sources.
    if (any(_GridSize <= 0) || any(id.xy >= (uint2)_GridSize) || _Spacing <= 0.0 || _DrawDistance <= 0.0)
        return;

    int2 cell = _GridStartIndex + int2(id.xy);
    uint seed = GrassCellSeed(cell);
    float2 jitter = float2(GrassRandom(seed, 0xa511e9b3u), GrassRandom(seed, 0x63d83595u)) - 0.5;
    float2 positionXZ = (float2(cell) + jitter) * _Spacing;

    // Cheap conservative rejection before any texture fetch or square root.
    float2 cameraDeltaXZ = positionXZ - _CameraPosition.xz;
    if (dot(cameraDeltaXZ, cameraDeltaXZ) >= _DrawDistance * _DrawDistance)
        return;

    float captureExtent = max(_TextureUpdateThreshold + _DrawDistance, 1e-4);
    float2 uv = (positionXZ - _CenterPos) / (2.0 * captureExtent) + 0.5;
    // Sampling clamp-to-edge outside an authored map must never grow grass.
    if (any(uv < 0.0) || any(uv >= 1.0))
        return;

    float authoredDensity = _AuthoredAreas != 0 ? saturate(_GrassDensityRT.SampleLevel(linearClampSampler, uv, 0)) : 1.0;
    if (authoredDensity <= 0.0)
        return;
    float exclusion = saturate(_GrassMaskMapRT.SampleLevel(linearClampSampler, uv, 0));
    if (exclusion >= 1.0)
        return;

    float heightWS;
    float surfaceValidity = 1.0;
    if (_UseTerrain != 0)
    {
        if (!GrassTerrainHeight(positionXZ, heightWS))
            return;
    }
    else
    {
        float2 heightAndValidity = _GrassHeightMapRT.SampleLevel(linearClampSampler, uv, 0);
        heightWS = heightAndValidity.r;
        surfaceValidity = saturate(heightAndValidity.g);
        if (surfaceValidity <= 0.0)
            return;
    }

    float3 positionWS = float3(positionXZ.x, heightWS, positionXZ.y);
    if (!GrassInFrustum(positionWS))
        return;

    float distanceToCamera = distance(_CameraPosition, positionWS);
    if (distanceToCamera >= _DrawDistance)
        return;

    float fullDensityDistance = clamp(_FullDensityDistance, 0.0, _DrawDistance);
    float fadeRange = max(_DrawDistance - fullDensityDistance, 1e-4);
    float distanceDensity = pow(saturate((_DrawDistance - distanceToCamera) / fadeRange), max(_DensityFalloffExponent, 0.0));
    float probability = saturate(authoredDensity * surfaceValidity * (1.0 - exclusion) * distanceDensity);
    float coverage = GrassDensityCoverage(probability, GrassRandom(seed, 0xb5297a4du));
    if (coverage <= 0.0)
        return;

    uint lod = GrassSelectLod(distanceToCamera, GrassRandom(seed, 0x68e31da4u));
    uint capacity = (uint)max(_LodCapacities[lod], 0);
    uint slot;
    InterlockedAdd(_GrassCounts[lod], 1u, slot);
    if (slot >= capacity)
    {
        InterlockedAdd(_GrassCounts[3], 1u);
        return;
    }

    // Atomic reservation assigns disjoint locations; capacity is checked before
    // the write, and FinalizeArgs also clamps the draw count to its owned range.
    _GrassPositions[(uint)_LodOffsets[lod] + slot] = float4(positionWS, coverage);
}

[numthreads(4, 1, 1)]
void FinalizeArgs(uint3 id : SV_DispatchThreadID)
{
    uint lod = id.x;
    if (lod >= 3)
        return;

    uint capacity = (uint)max(_LodCapacities[lod], 0);
    uint instanceCount = min(_GrassCounts[lod], capacity);
    // The CPU initializes the other fields using IndirectDrawIndexedArgs.
    // Its platform-supplied stride and field offset avoid assuming a 20-byte ABI.
    uint byteOffset = lod * (uint)_ArgsStride + (uint)_ArgsInstanceCountOffset;
    _GrassIndirectArgs.Store(byteOffset, instanceCount);
}
